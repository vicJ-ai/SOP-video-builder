# Copy to backend/.env. Every value is optional; defaults run fully offline in mock mode.

# --- Vision-language model: Qwen3-VL behind any OpenAI-compatible endpoint ---------------
# On a GPU box:  vllm serve Qwen/Qwen3-VL-8B-Instruct --port 8000 --max-model-len 32768 \
#                  --limit-mm-per-prompt '{"image": 48}'
VLM_PROVIDER=mock                 # openai | mock
VLM_BASE_URL=http://gpu-box:8000/v1
VLM_API_KEY=EMPTY
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_COARSE_FPS=1                  # first pass over the combined preview
VLM_FINE_FPS=6                    # second pass on short windows (taps, scans, confirmations)
VLM_CHUNK_S=30
VLM_MAX_FRAMES=32
# MOCK_EVENTS_PATH=../samples/mock_events.json   # simulate VLM output (demo / tests)

# --- Optional text LLM (SOP-match refinement, narration polishing) ------------------------
LLM_PROVIDER=none                 # openai | none   (defaults to the VLM endpoint when openai)

# --- Text-to-speech -------------------------------------------------------------------
TTS_PROVIDER=mock                 # openai (Qwen3-TTS /v1/audio/speech) | kokoro | system | mock
TTS_BASE_URL=http://gpu-box:8001/v1
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_VOICE=Ryan                    # a fixed, approved preset voice — never clone an employee without consent

# --- Transcription (faster-whisper; install with `uv sync --extra asr`) -----------------
ASR_MODEL=small

# --- Rendering --------------------------------------------------------------------------
RENDERER=remotion                 # remotion (Remocn components) | ffmpeg (license-free fallback)
RENDER_CONCURRENCY=50%

# SKELLYSYNC_PYTHON=../tools/skellysync/.venv/Scripts/python.exe   # set up by scripts/setup.ps1
# SOP_DATA_DIR=../projects
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
